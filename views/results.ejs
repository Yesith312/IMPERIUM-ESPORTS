<%- include('partials/head') %>
<section class="wrap"><h1>Resultados y estadísticas</h1>
<% if (!rows.length && !players.length) { %><p class="empty">Aún no hay resultados publicados. Próximamente.</p><% } %>
<% if (rows.length) { %>
<div class="grid small"><div class="card center-text"><h3><%= totals.points %></h3><p>Puntos</p></div><div class="card center-text"><h3><%= totals.booyahs %></h3><p>Booyahs</p></div><div class="card center-text"><h3><%= totals.kills %></h3><p>Eliminaciones</p></div><div class="card center-text"><h3><%= totals.matches %></h3><p>Partidas</p></div></div>
<div class="charts"><%- barChart(rows.map(r => ({ label: r.tournament, value: r.points || 0 })), 'Puntos por torneo') %><%- barChart(rows.map(r => ({ label: r.tournament, value: r.booyahs || 0 })), 'Booyahs por torneo') %></div>
<h2>Historial de temporadas</h2>
<% Object.entries(seasons).forEach(([season, list]) => { %><h3><%= season %></h3>
<div class="table-wrap"><table><thead><tr><th>Torneo</th><th>Pos.</th><th>Puntos</th><th>Booyahs</th><th>Elim.</th><th>Partidas</th></tr></thead><tbody>
<% list.forEach(r => { %><tr><td><%= r.tournament %></td><td><%= r.position ?? '—' %></td><td><%= r.points ?? 0 %></td><td><%= r.booyahs ?? 0 %></td><td><%= r.kills ?? 0 %></td><td><%= r.matches ?? 0 %></td></tr><% }) %></tbody></table></div><% }) %>
<% } %>
<% if (players.length) { %><h2>Rendimiento por jugador</h2>
<div class="charts"><%- barChart(players.map(p => ({ label: p.player, value: p.kills })), 'Eliminaciones por jugador') %></div>
<div class="table-wrap"><table><thead><tr><th>Jugador</th><th>Elim.</th><th>Booyahs</th><th>Partidas</th><th>Puntos</th></tr></thead><tbody>
<% players.forEach(p => { %><tr><td><b><%= p.player %></b></td><td><%= p.kills %></td><td><%= p.booyahs %></td><td><%= p.matches %></td><td><%= p.points %></td></tr><% }) %></tbody></table></div><% } %>
</section>
<%- include('partials/foot') %>
