<%- include('../partials/head', { desc: 'Panel' }) %>
<%- include('nav') %>
<h1>Postulación <%= a.code %></h1>
<div class="table-wrap"><table><tbody>
<%
function formatApplicationValue(key, value) {
  if (value === null || value === undefined || value === '') return '—';

  if (key === '_discord' && typeof value === 'object') {
    const username = value.username || value.globalName || value.tag;
    const id = value.user_id || value.discord_id || value.id;
    return [username ? '@' + username : '', id ? 'ID: ' + id : '']
      .filter(Boolean).join(' · ') || 'Sin información de Discord';
  }

  if (key === '_historial' && Array.isArray(value)) {
    if (!value.length) return 'Sin movimientos';
    return value.map(item => {
      const fecha = item.fecha && !isNaN(Date.parse(item.fecha))
        ? new Date(item.fecha).toLocaleString('es-CO', { timeZone: 'America/Bogota' })
        : 'Fecha no disponible';
      const estado = String(item.estado || 'Sin estado').replace(/_/g, ' ');
      return `${fecha} — ${estado} · Usuario: ${item.por || 'No identificado'}`;
    }).join('\\n');
  }

  if (key === 'discord' && typeof value === 'string') {
    return value.startsWith('@') ? value : '@' + value;
  }

  if (Array.isArray(value)) {
    return value.map(item => {
      if (item && typeof item === 'object') {
        return Object.entries(item)
          .map(([k, v]) => `${k}: ${formatApplicationValue(k, v)}`)
          .join(' · ');
      }
      return String(item);
    }).join('\\n');
  }

  if (typeof value === 'object') {
    return Object.entries(value)
      .map(([k, v]) => `${k}: ${formatApplicationValue(k, v)}`)
      .join('\\n');
  }

  return String(value);
}

function applicationLabel(key) {
  return ({
    _discord: 'Discord (datos de cuenta)',
    _historial: 'Historial de estados',
    _form: 'Formulario',
    discord: 'Usuario de Discord'
  })[key] || key.replace(/_/g, ' ');
}
%>
<% Object.entries(a.data || {}).forEach(([k, v]) => { %>
<tr>
  <th><%= applicationLabel(k) %></th>
  <td style="white-space:pre-line"><%= formatApplicationValue(k, v) %></td>
</tr>
<% }) %>
<tr><th>Autorización representante</th><td><%= a.guardian_consent ? 'Sí' : 'No aplica' %></td></tr></tbody></table></div>
<h2>Gestión y evaluación privada</h2>
<form method="post" class="form" action="/admin/solicitudes/<%= a.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>">
<label>Estado<select name="status"><% statuses.forEach(s => { %><option value="<%= s.value %>" <%= a.status === s.value ? 'selected' : '' %>><%= s.label %></option><% }) %></select></label>
<% evalKeys.forEach(k => { %><label><%= k.replace('_', ' ') %> (1-10)<input type="number" name="ev_<%= k %>" min="1" max="10" value="<%= a.evaluation && a.evaluation[k] ? a.evaluation[k] : '' %>"></label><% }) %>
<label>Observaciones privadas<textarea name="notes" rows="5"><%= a.notes || '' %></textarea></label>
<button class="btn">Guardar</button></form>
<h2>Tryouts</h2>
<% regs.forEach(g => { %><p><span class="tag"><%= g.attendance %></span> <%= g.title %></p><% }) %>
<% if (tryouts.length) { %><form method="post" class="form" action="/admin/solicitudes/<%= a.id %>/invitar"><input type="hidden" name="_csrf" value="<%= csrf %>">
<label>Invitar a un tryout<select name="tryout_id"><% tryouts.forEach(t => { %><option value="<%= t.id %>"><%= t.title %> · <%= fmt(t.starts_at) %></option><% }) %></select></label><button class="btn ghost">Invitar</button></form><% } else { %><p class="muted">No hay tryouts abiertos. Crea uno en la sección Tryouts.</p><% } %></div>
<%- include('../partials/foot') %>
