<%- include('../partials/head', { desc: 'Panel' }) %>
<%- include('nav') %>
<h1>Usuarios y permisos</h1>
<div class="table-wrap"><table><thead><tr><th>Correo</th><th>Nombre</th><th>Rol</th><th>Estado</th><th></th></tr></thead><tbody>
<% list.forEach(u => { %><tr><td><%= u.email %></td><td><%= u.full_name %></td><td><%= u.role %></td><td><%= u.active ? 'Activo' : 'Desactivado' %></td>
<td><% if (u.email !== user.email) { %><form class="inline" method="post" action="/admin/usuarios/<%= u.id %>/estado"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link"><%= u.active ? 'Desactivar' : 'Activar' %></button></form>
<form class="inline" method="post" action="/admin/usuarios/<%= u.id %>/eliminar" data-confirm="¿Eliminar este usuario?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link">Eliminar</button></form><% } %></td></tr><% }) %></tbody></table></div>
<h2>Crear o actualizar usuario</h2>
<form method="post" class="form" action="/admin/usuarios"><input type="hidden" name="_csrf" value="<%= csrf %>">
<label>Nombre<input name="full_name" maxlength="100"></label>
<label>Correo<input type="email" name="email" required></label>
<label>Contraseña (mínimo 12 caracteres)<input type="password" name="password" minlength="12" required autocomplete="new-password"></label>
<label>Rol<select name="role"><% roles.forEach(r => { %><option><%= r %></option><% }) %></select></label>
<button class="btn">Guardar</button></form></div>
<%- include('../partials/foot') %>
