<%- include('../partials/head', { desc: 'Mi perfil' }) %>
<section class="wrap narrow"><h1>Mi perfil</h1><p class="muted"><%= me.email %> · <%= me.role %> · <a href="/portal">Volver al portal</a></p>
<form method="post" action="/portal/perfil" class="form"><input type="hidden" name="_csrf" value="<%= csrf %>">
<label>Nombre completo<input name="full_name" maxlength="100" value="<%= me.full_name || '' %>"></label>
<label>Discord<input name="discord" maxlength="80" value="<%= me.discord || '' %>"></label>
<label>Teléfono<input name="phone" maxlength="30" value="<%= me.phone || '' %>"></label>
<button class="btn">Guardar datos</button></form>
<h2>Cambiar contraseña</h2>
<form method="post" action="/portal/clave" class="form"><input type="hidden" name="_csrf" value="<%= csrf %>">
<label>Contraseña actual<input type="password" name="current" required autocomplete="current-password"></label>
<label>Nueva contraseña (mínimo 12 caracteres)<input type="password" name="next" required minlength="12" autocomplete="new-password"></label>
<label>Confirmar<input type="password" name="confirm" required minlength="12" autocomplete="new-password"></label>
<button class="btn">Cambiar contraseña</button></form></section>
<%- include('../partials/foot') %>
